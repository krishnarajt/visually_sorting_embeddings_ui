# Where the backend lives. You almost never need to set this.
#
#   - `npm run dev` leaves it empty and the Vite dev server proxies /api to
#     VITE_DEV_API instead, so there is no CORS to deal with locally.
#   - A production build with this *unset* talks to
#     https://vsembeddings-api.krishnarajthadesar.in — see DEFAULT_API_BASE in
#     src/lib/api.js. That is what Vercel and Netlify both build, with nothing
#     configured in either dashboard.
#
# Set it to point a build somewhere else, or set it to an empty value
# (VITE_API_BASE=) for a build with no backend at all, which serves the
# precomputed bundle in public/demo.
# VITE_API_BASE=https://vsembeddings-api.krishnarajthadesar.in

# Only used by `npm run dev`. Defaults to http://localhost:1184.
VITE_DEV_API=http://localhost:1184
