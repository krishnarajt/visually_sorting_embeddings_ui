# Netlify only (Vercel reads vercel.json); the same two rules.

# Hashed filenames: safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The offline bundle is regenerated by scripts/export_demo.py without a rename.
/demo/*
  Cache-Control: public, max-age=3600, must-revalidate
